{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegisqa.local/schemas/skill_manifest.schema.json",
  "title": "AegisQA Skill Manifest v1",
  "type": "object",
  "required": ["schema_version", "skill_id", "name", "version", "description", "type", "category", "input_schema", "output_schema"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "skill_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "type": { "type": "string", "enum": ["prompt", "code", "hybrid"] },
    "category": { "type": "string", "enum": ["judge", "extractor", "aggregator", "source", "transformer", "reporter", "legacy"] },
    "runtime": {
      "type": "object",
      "properties": {
        "kind": { "type": "string" },
        "entrypoint": { "type": "string" }
      },
      "additionalProperties": true
    },
    "prompts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "llm_permissions": {
      "type": "object",
      "properties": {
        "allowed_prompt_names": { "type": "array", "items": { "type": "string" } },
        "allowed_model_aliases": { "type": "array", "items": { "type": "string" } },
        "max_calls_per_run": { "type": "integer", "minimum": 0 },
        "max_tokens_per_run": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "limits": { "type": "object", "additionalProperties": true },
    "input_schema": { "type": "object" },
    "output_schema": { "type": "object" },
    "config_schema": { "type": "object" },
    "example_input": { "type": "object" },
    "example_config": { "type": "object" }
  },
  "additionalProperties": true
}
