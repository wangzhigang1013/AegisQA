{
  "schema_version": 1,
  "skill_id": "example.prompt_judge@0.1.0",
  "name": "Prompt Judge Example",
  "version": "0.1.0",
  "description": "A v1 prompt skill package with registered prompt assets.",
  "type": "prompt",
  "category": "judge",
  "runtime": { "kind": "python", "entrypoint": "handler.py" },
  "prompts": [{ "name": "judge", "path": "prompts/judge" }],
  "llm_permissions": {
    "allowed_prompt_names": ["judge"],
    "allowed_model_aliases": ["test.judge"],
    "max_calls_per_run": 1,
    "max_tokens_per_run": 1000
  },
  "limits": { "timeout_seconds": 60 },
  "input_schema": {
    "type": "object",
    "properties": { "text": { "type": "string" } },
    "required": ["text"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "verdict": { "type": "string" },
      "evidence": { "type": "string" }
    },
    "required": ["verdict", "evidence"]
  },
  "config_schema": { "type": "object" },
  "example_input": { "text": "hello" },
  "example_config": {}
}
