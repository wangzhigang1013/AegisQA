# ============================================
# AegisQA 环境变量配置示例
# ============================================

# --------------------------------------------
# 存储配置
# --------------------------------------------
# 存储后端: json | sqlite | mysql
AEGISQA_STORAGE_BACKEND=json
# 数据存储根目录
AEGISQA_STORE_ROOT=data/aegisqa_store

# MySQL 配置（仅当 AEGISQA_STORAGE_BACKEND=mysql 时需要）
# AEGISQA_MYSQL_HOST=localhost
# AEGISQA_MYSQL_PORT=3306
# AEGISQA_MYSQL_USER=aegisqa
# AEGISQA_MYSQL_PASSWORD=your_password_here
# AEGISQA_MYSQL_DATABASE=aegisqa
# AEGISQA_MYSQL_POOL_MIN_SIZE=2
# AEGISQA_MYSQL_POOL_MAX_SIZE=10
# AEGISQA_MYSQL_POOL_MAX_IDLE=300

# --------------------------------------------
# Redis 配置（可选，用于缓存和速率限制）
# --------------------------------------------
# AEGISQA_REDIS_URL=redis://localhost:6379/0

# --------------------------------------------
# 模型网关配置
# --------------------------------------------
# 模型提供商: mock | openai | openai_compatible | anthropic
# AEGISQA_MODEL_PROVIDER=mock
# AEGISQA_MODEL_BASE_URL=https://api.openai.com/v1
# AEGISQA_MODEL_API_KEY=sk-your-api-key-here
# AEGISQA_MODEL_DEFAULT=gpt-4
# AEGISQA_MODEL_TIMEOUT=120

# --------------------------------------------
# JWT 认证配置
# --------------------------------------------
# JWT 密钥（生产环境必须修改）
AEGISQA_JWT_SECRET=change-this-to-a-random-secret-in-production
# 访问令牌过期时间（秒）
AEGISQA_JWT_ACCESS_EXPIRE=3600
# 刷新令牌过期时间（秒）
AEGISQA_JWT_REFRESH_EXPIRE=604800

# --------------------------------------------
# 速率限制配置
# --------------------------------------------
# 是否启用速率限制
AEGISQA_RATE_LIMIT_ENABLED=true
# 每个窗口允许的请求数
AEGISQA_RATE_LIMIT_REQUESTS=100
# 窗口大小（秒）
AEGISQA_RATE_LIMIT_WINDOW=60

# --------------------------------------------
# CORS 配置
# --------------------------------------------
# 允许的源（逗号分隔）
AEGISQA_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --------------------------------------------
# 日志配置
# --------------------------------------------
# 日志级别: DEBUG | INFO | WARNING | ERROR | CRITICAL
AEGISQA_LOG_LEVEL=INFO
# 日志格式: json | text
AEGISQA_LOG_FORMAT=json

# --------------------------------------------
# 追踪配置（可选）
# --------------------------------------------
# 是否启用分布式追踪
# AEGISQA_TRACING_ENABLED=false
# OpenTelemetry 端点
# AEGISQA_OTEL_ENDPOINT=http://localhost:4317
# 服务名称
# AEGISQA_OTEL_SERVICE_NAME=aegisqa

# --------------------------------------------
# 缓存配置
# --------------------------------------------
# 缓存 TTL（秒）
AEGISQA_CACHE_TTL=3600
# 缓存键前缀
AEGISQA_CACHE_PREFIX=aegisqa:cache:

# --------------------------------------------
# 前端配置
# --------------------------------------------
# 前端 URL（用于后端返回）
AEGISQA_FRONTEND_URL=http://localhost:5173
